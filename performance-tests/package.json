{
  "name": "@flying-squid/performance-tests",
  "version": "1.0.0",
  "description": "Modern performance testing framework for Flying Squid Minecraft server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "perf:movement": "tsx src/scenarios/movement.ts",
    "perf:building": "tsx src/scenarios/building.ts",
    "perf:load": "tsx src/scenarios/load-test.ts",
    "perf:all": "tsx src/runner.ts --all",
    "perf:report": "tsx src/reporting/generator.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "mineflayer": "^4.0.0",
    "minecraft-protocol": "^1.60.1",
    "minecraft-data": "^3.95.0",
    "vec3": "^0.1.8",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "figlet": "^1.7.0",
    "boxen": "^7.1.1",
    "node-cron": "^3.0.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.10.1",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0",
    "@types/figlet": "^1.5.8",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "minecraft",
    "performance",
    "testing",
    "benchmark",
    "mineflayer"
  ],
  "author": "Flying Squid Team",
  "license": "MIT"
}