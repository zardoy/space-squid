{
  "name": "flying-squid-perf-tests",
  "version": "1.0.0",
  "description": "Performance testing framework for Flying Squid Minecraft server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "perf:movement": "tsx src/scenarios/MovementScenario.ts",
    "perf:building": "tsx src/scenarios/BuildingScenario.ts",
    "perf:load": "tsx src/scenarios/LoadTestScenario.ts",
    "perf:all": "tsx src/runners/PerformanceTestRunner.ts --all",
    "perf:report": "tsx src/reports/ReportGenerator.ts",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "mineflayer": "^4.0.0",
    "minecraft-protocol": "^1.60.1",
    "minecraft-data": "^3.95.0",
    "vec3": "^0.1.8",
    "performance-now": "^0.2.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.10.1",
    "vitest": "^0.34.6",
    "@types/node": "^20.0.0",
    "@types/performance-now": "^0.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}